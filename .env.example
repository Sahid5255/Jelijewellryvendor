# Copy this file to .env (or .env.local) and fill in your values.
# Every variable is OPTIONAL: the store runs with the built-in React products
# and local cart/wishlist even if all of these are missing.

# --- Supabase (optional: future products, admin dashboard, store settings) ---
# Find both values in Supabase > Project Settings > API.
# Use the "anon" / public key ONLY. NEVER put the service_role key in this file
# or anywhere in frontend code: anything prefixed VITE_ is shipped to browsers.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- WhatsApp checkout ---
# Business number in international format, digits only (no +, spaces or dashes).
# Example for a number +1 555 010 0000 -> 15550100000
# Can also be changed later in Admin > Settings (when Supabase is connected).
VITE_WHATSAPP_NUMBER=

# --- Display ---
# ISO 4217 currency code used to format prices (USD, NGN, GBP, EUR, ...).
VITE_CURRENCY=USD
